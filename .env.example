# Salin file ini menjadi .env bila ingin mengubah nilai bawaan.
# Tanpa .env pun proyek tetap jalan (nilai default sudah ditulis
# langsung di docker-compose.yml).

RABBITMQ_USER=admin
RABBITMQ_PASS=admin123

POSTGRES_USER=payments
POSTGRES_PASSWORD=payments123
POSTGRES_DB=payments

# Jeda sebelum pesan gagal dicoba lagi (milidetik)
RETRY_TTL_MS=5000
# Berapa kali pesan dicoba ulang sebelum masuk Dead Letter Queue
MAX_RETRY=2
